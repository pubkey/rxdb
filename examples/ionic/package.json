{
  "name": "rxdb-example-ionic",
  "version": "1.0.0",
  "private": true,
  "author": "pubkey",
  "license": "MIT",
  "description": "RxDB example app built with Ionic and Capacitor",
  "//": "NOTICE: For the Github CI we use the local RxDB build (rxdb-local.tgz). In your app should just install 'rxdb' from npm instead",
  "scripts": {
    "preinstall": "npm run preinstall:rxdb",
    "preinstall:rxdb": "(cd ../../ && npx yarn@1.22.22 pack ../../ --filename ./examples/ionic/rxdb-local.tgz)",
    "dev": "ng serve --port 8100",
    "build": "ng build --configuration production",
    "build:serve": "ws -p 8100 -d dist/ionic/browser --spa index.html",
    "lint": "ng lint",
    "test:e2e": "testcafe \"path:$BROWSER_PATH --no-sandbox --disable-dev-shm-usage\" -e test/ --hostname localhost --selector-timeout 30000 --disable-features=LocalNetworkAccessChecks",
    "test": "npm run build && concurrently \"npm run build:serve\" \"npm run test:e2e\" --kill-others --success first",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npm run cap:sync && npx cap open android",
    "cap:open:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@ionic/angular": "8.8.16",
    "ionicons": "8.1.0",
    "rxdb": "file:rxdb-local.tgz",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.0",
    "@capacitor/cli": "8.5.0",
    "async-test-util": "2.5.0",
    "concurrently": "10.0.4",
    "local-web-server": "5.4.0",
    "testcafe": "3.7.6",
    "typescript": "6.0.3"
  }
}
